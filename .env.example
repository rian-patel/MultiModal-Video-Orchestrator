# Copy to .env and fill in. Not needed for Phase 0 (mock pipeline).
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
# Hosted mode (H1): these live on the SERVICES, not in this file — see HOSTING.md.
#   Trigger.dev worker env: ANTHROPIC_API_KEY, HIGGSFIELD_API_KEY, SUPABASE_URL,
#                           SUPABASE_SERVICE_ROLE_KEY
#   Vercel web env:         VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   Supabase functions:     TRIGGER_SECRET_KEY (via `supabase secrets set`)

# Optional videogen tuning:
# HIGGSFIELD_MODEL=dop-turbo            # dop-turbo | dop-lite | dop-preview (720p, cheap, motion-strength lever)
#                                       # | seedance_pro | seedance_lite (native 1080p, ~3.5x cost, prompt-driven camera)
# HIGGSFIELD_MOTION_STRENGTH=0.3        # dop-* only: 0..1; lower = less camera travel = higher fidelity
